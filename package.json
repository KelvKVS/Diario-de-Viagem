{
    "scripts": {
        "build": "echo 'no build step needed'",
        "start": "node backend/src/app.js && node frontend/dist/index.js",
        "start:dev": "npm-run-all --parallel dev:backend dev:frontend",
        "dev:backend": "npm --prefix backend run dev",
        "dev:frontend": "npm --prefix frontend run dev"
    },
    "devDependencies": {
        "npm-run-all": "^4.1.5"
    }
}
